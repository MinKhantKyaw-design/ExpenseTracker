@model ExpenseTracker.DTOs.ExpenseDto

@{
    ViewData["Title"] = "Delete Expense";
}

<div class="container">

    <h2>Delete Expense</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this expense?
    </div>

    <dl class="row">

        <dt class="col-sm-2">
            Category
        </dt>

        <dd class="col-sm-10">
            @Model.CategoryName
        </dd>

        <dt class="col-sm-2">
            Amount
        </dt>

        <dd class="col-sm-10">
            @Model.Amount.ToString("N2")
        </dd>

        <dt class="col-sm-2">
            Date
        </dt>

        <dd class="col-sm-10">
            @Model.Date.ToString("yyyy-MM-dd")
        </dd>

        <dt class="col-sm-2">
            Notes
        </dt>

        <dd class="col-sm-10">
            @Model.Notes
        </dd>

    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.ExpenseID"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>