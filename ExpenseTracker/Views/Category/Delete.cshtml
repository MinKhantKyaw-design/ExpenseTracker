@model ExpenseTracker.DTOs.CategoryDto

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container">

    <h2>Delete Category</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this category?
    </div>

    <dl class="row">

        <dt class="col-sm-2">
            Name
        </dt>

        <dd class="col-sm-10">
            @Model.Name
        </dd>


        <dt class="col-sm-2">
            Description
        </dt>

        <dd class="col-sm-10">
            @Model.Description
        </dd>

    </dl>


    <form asp-action="Delete"
          asp-route-id="@Model.CategoryID"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>